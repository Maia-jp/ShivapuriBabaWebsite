---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { Content as Biography } from '../../content/ja/biography.md';
import bennettPhoto from '../../assets/shivapuri-baba-bennett.jpg';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Structured data helps search engines understand the page is about a person.
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Shivapuri Baba',
	alternateName: ['Sri Govindananda Bharati', 'Govindananda Bharati'],
	birthDate: '1826',
	deathDate: '1963-01-28',
	birthPlace: 'South India',
	description:
		'ナルマダーの森での長い苦行ののちに神の実現に達し、正命の道（Swadharma）を説いたインドの聖者にして遁世者。晩年の数十年をネパールのカトマンズ近郊で過ごした。',
	url: canonicalURL.href,
	inLanguage: 'ja',
	sameAs: ['https://en.wikipedia.org/wiki/Shivapuri_Baba'],
};
---

<Layout
	title="シヴァプリ・ババの伝記（1826–1963）"
	description="シヴァプリ・ババ（Sri Govindananda Bharati、1826–1963）の生涯。直接の目撃者による資料——主として J. G. Bennett と Dr. Ainslie Meares——のみにもとづき、完全な出典を付す。"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(personSchema)}
		is:inline
	/>

	<div class="py-10 md:py-16">
		<div class="mx-auto max-w-2xl">
			<article class="prose">
				<figure>
					<Picture
						src={bennettPhoto}
						formats={['avif', 'webp']}
						widths={[672, 1008, 1344]}
						sizes="(min-width: 768px) 672px, 100vw"
						alt="シヴァプリ・ババ。J. G. Bennett のカトマンズ訪問中に撮影、1961–62年"
						loading="eager"
					/>
					<figcaption>
						シヴァプリ・ババ。写真提供：
						<a
							href="https://www.jgbennett.org/tag/shivapuri-baba/"
							target="_blank"
							rel="noopener noreferrer">J. G. Bennett Foundation</a
						>。
					</figcaption>
				</figure>
				<Biography />
			</article>

			<nav
				class="mt-16 border-t border-[color:var(--color-border)] pt-8 text-sm"
				aria-label="続けて読む"
			>
				<p class="mb-3 text-[color:var(--color-muted)]">さらに読む</p>
				<ul class="space-y-3">
					<li>
						<a href="/ja/teachings/right-living" class="underline-offset-2 hover:underline"
							>正命の道（Swadharma）</a
						><span class="text-[color:var(--color-muted)]"> — 完全に説き明かされた教え</span>
					</li>
					<li>
						<a href="/ja/books" class="underline-offset-2 hover:underline">書籍とメディア</a
						><span class="text-[color:var(--color-muted)]">
							— これらの資料をどこで見つけるか、在庫のあるものか無料の借覧か</span
						>
					</li>
				</ul>
			</nav>
		</div>
	</div>
</Layout>
