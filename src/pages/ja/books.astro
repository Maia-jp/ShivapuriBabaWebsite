---
import Layout from '../../layouts/Layout.astro';
import { Content as Books } from '../../content/ja/books.md';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Structured data: a reading list of the first-hand books, for richer search results.
const bennett = { '@type': 'Person', name: 'J. G. Bennett' };
const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'シヴァプリ・ババ — 書籍・メディア・参考資料',
	about: { '@type': 'Person', name: 'Shivapuri Baba' },
	inLanguage: 'ja',
	url: canonicalURL.href,
	hasPart: [
		{
			'@type': 'Book',
			name: 'Long Pilgrimage: The Life and Teaching of the Shivapuri Baba',
			author: [bennett, { '@type': 'Person', name: 'Thakur Lal Manandhar' }],
			datePublished: '1965',
			isbn: '978-1530624317',
			about: { '@type': 'Person', name: 'Shivapuri Baba' },
		},
		{
			'@type': 'Book',
			name: 'Witness: The Story of a Search',
			author: bennett,
			datePublished: '1962',
		},
		{
			'@type': 'Book',
			name: 'The Shivapuri Baba and His Message: Four Lectures on a Great Indian Sage',
			author: bennett,
			isbn: '978-1533489319',
			about: { '@type': 'Person', name: 'Shivapuri Baba' },
		},
		{
			'@type': 'Book',
			name: 'Strange Places, Simple Truths',
			author: { '@type': 'Person', name: 'Ainslie Meares' },
			datePublished: '1969',
		},
		{
			'@type': 'Book',
			name: 'Right Life: Teachings of the Shivapuri Baba',
			author: { '@type': 'Person', name: 'Renu Lal Singh' },
			datePublished: '1975',
			isbn: '0-900306-82-3',
			about: { '@type': 'Person', name: 'Shivapuri Baba' },
		},
		{
			'@type': 'Book',
			name: 'Right Living: The Teaching of Sri Shivapuri Baba',
			author: { '@type': 'Person', name: 'Yogendra Bhakta Shrestha Malla' },
			about: { '@type': 'Person', name: 'Shivapuri Baba' },
		},
		{
			'@type': 'Book',
			name: 'Swadharma',
			author: { '@type': 'Person', name: 'Bishnu Prasad Timilsina' },
			inLanguage: 'ne',
			about: { '@type': 'Person', name: 'Shivapuri Baba' },
		},
	],
};
---

<Layout
	title="シヴァプリ・ババ — 書籍・メディア・参考資料"
	description="シヴァプリ・ババに関する書籍・音声・参考資料をどこで見つけるか。一次資料の記述（Bennett、Meares）、弟子による編集書、1962年の録音、さらに読むための資料——販売元と無料借覧へのリンクつき。"
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(collectionSchema)}
		is:inline
	/>

	<div class="py-10 md:py-16">
		<div class="mx-auto max-w-2xl">
			<article class="prose">
				<Books />
			</article>

			<nav
				class="mt-16 border-t border-[color:var(--color-border)] pt-8 text-sm"
				aria-label="続けて読む"
			>
				<p class="mb-3 text-[color:var(--color-muted)]">さらに読む</p>
				<ul class="space-y-3">
					<li>
						<a href="/ja/biography" class="underline-offset-2 hover:underline">伝記</a
						><span class="text-[color:var(--color-muted)]">
							— 生涯、一次資料のみにもとづく</span
						>
					</li>
					<li>
						<a href="/ja/teachings/right-living" class="underline-offset-2 hover:underline"
							>正命の道（Swadharma）</a
						><span class="text-[color:var(--color-muted)]"> — 完全に説き明かされた教え</span>
					</li>
				</ul>
			</nav>
		</div>
	</div>
</Layout>
